

@model List<ngocyen.Promotions.Dto.PromotionDto>
@{
    ViewBag.Title = "Quản lý Promotion";
}
<section class="content-header">
    <div class="container-fluid">
        <h1> Promotion</h1>
    </div>
</section>

<section class="content">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center w-100">
                <h3 class="card-title mb-0">Danh sách Voucher</h3>

                <button class="btn btn-primary" onclick="openCreateModal()">
                    <i class="fa fa-plus"></i> Thêm Voucher
                </button>
            </div>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <input type="text"
                           id="searchPromotion"
                           class="form-control"
                           placeholder="Tìm theo tên hoặc mã voucher" />
                </div>

                <div class="col-md-3">
                    <select id="filterStatus" class="form-control">
                        <option value="">Tất cả trạng thái</option>
                        <option value="active">Hoạt động</option>
                        <option value="inactive">Ngừng hoạt động</option>
                    </select>
                </div>
            </div>
            <table class="table table-bordered table-striped">
                <thead>
                <tr>
                    <th>Tên</th>
                    <th>Mã Giảm Giá</th>
                    <th>Số Lượng</th>
                    <th>Đã Dùng</th>
                    <th>Trạng Thái</th>
                    <th>Thao Tác</th>
                </tr>
                </thead>
                <tbody id="promotionTableBody"></tbody>
            </table>
        </div>
    </div>
</section>
<div class="modal fade" id="PromotionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Thêm Voucher</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <input id="Name" class="form-control mb-2" placeholder="Tên Voucher" />
                <input id="Code" class="form-control mb-2" placeholder="Mã Giảm Giá" />
                <input id="Discount" class="form-control mb-2" placeholder="% Giảm" />
                <input id="Quantity" class="form-control mb-2" placeholder="Số Lượng" />
            </div>

            <div class="modal-footer">
                <button class="btn btn-success" onclick="savePromotion()">Lưu</button>
            </div>

        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/view-resources/Views/Promotion/Index.js"></script>